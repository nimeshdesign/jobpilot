# Copy this file to .env and edit. Everything here is optional — JobPilot
# fetches, scores, tailors and fills in application forms with no AI at all.
# AI only improves the wording of the tailored summary and cover letter.

# ---------------------------------------------------------------------------
# AI provider:  auto | ollama | openai | anthropic | none
# "auto" picks a local model first, then an OpenAI-compatible endpoint, then
# Claude — so a free local model never loses to a paid API by accident.
# ---------------------------------------------------------------------------
JOBPILOT_LLM_PROVIDER=auto


# --- Option 1: a model on your own machine (FREE, and nothing leaves it) ----
# Install Ollama from https://ollama.com, then in a terminal:
#     ollama pull llama3.1:8b
# It serves on 11434 automatically; JobPilot finds it with no key.
# On a machine with no usable GPU, prefer a small model — qwen2.5:3b or
# llama3.2:3b answer in a couple of minutes instead of five-plus.
JOBPILOT_OLLAMA_URL=http://127.0.0.1:11434
JOBPILOT_OLLAMA_MODEL=llama3.1:8b


# --- Option 2: any OpenAI-compatible API (several have free tiers) ----------
# Works with Groq, OpenRouter, Together, Google's OpenAI-compat endpoint,
# LM Studio and llama.cpp. Your resume and the job description are sent to
# whoever you point this at, so it is not private the way Ollama is.
#
#   Groq        https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1            a model ending in :free
#   Google      https://generativelanguage.googleapis.com/v1beta/openai
#                                                       gemini-2.0-flash
#   LM Studio   http://127.0.0.1:1234/v1                (whatever you loaded)
#
# JOBPILOT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# JOBPILOT_OPENAI_API_KEY=your-key-here
# JOBPILOT_OPENAI_MODEL=llama-3.3-70b-versatile


# --- Option 3: Claude (paid, best quality) ---------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
JOBPILOT_MODEL=claude-opus-5


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=8765

# Point a test run or a second profile at its own data directory. Everything —
# database, resumes, generated documents, screenshots, browser profile — lives
# under it, so nothing can collide with your real data.
# JOBPILOT_DATA_DIR=C:\somewhere\else
